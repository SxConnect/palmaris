# ---------------------------------------------------------------
# Banco de dados PostgreSQL (obrigatório)
# Docker Compose (dentro da rede do compose): host = "db"
# ---------------------------------------------------------------
DATABASE_URL="postgresql://palmaris:troque-esta-senha@localhost:5432/palmaris?schema=public"

# URL pública do site (usada em SEO, links de e-mail e no Compose)
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Porta em que o site responde dentro do container
# ---------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------
# Administrador inicial (usado pelo seed)
# Troque a senha antes de publicar!
# ---------------------------------------------------------------
ADMIN_EMAIL="contato@palmarisrepresentacoes.com.br"
ADMIN_PASSWORD="Palmaris@2026"
ADMIN_NAME="Palmaris Representações"
# Defina "true" para sobrescrever a senha do admin já existente (recuperar acesso).
ADMIN_RESET=false

# ---------------------------------------------------------------
# Credenciais do PostgreSQL no Docker Compose
# ---------------------------------------------------------------
POSTGRES_USER=palmaris
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=palmaris
APP_PORT=3000

# ---------------------------------------------------------------
# SMTP (opcional) — recuperação de senha do painel
# ---------------------------------------------------------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="seu@email.com"
# SMTP_PASS="senha_de_app"
# SMTP_FROM="Palmaris <seu@email.com>"
